{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":separateMajorReleases",
    ":combinePatchMinorReleases",
    "group:dotnetMonorepo",
    "group:nugetMonorepo",
    "security:openssf-scorecard"
  ],
  "mode": "full",
  "timezone": "Australia/Melbourne",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 10,
  "labels": ["dependencies"],
  "recreateWhen": "auto",
  "semanticCommits": "enabled",
  "semanticCommitType": "build",
  "semanticCommitScope": "deps",
  "commitMessageAction": "bump",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "schedule": ["at any time"],
    "labels": ["dependencies", "security"]
  },
  "packageRules": [
    {
      "description": "The Docfx comparison requires its matching compiler, decompiler, and benchmark runner versions.",
      "matchFileNames": ["src/benchmarks/Docfx.StandaloneBenchmarks/Docfx.StandaloneBenchmarks.csproj"],
      "matchPackageNames": ["BenchmarkDotNet", "Microsoft.CodeAnalysis.CSharp", "ICSharpCode.Decompiler", "YamlDotNet"],
      "enabled": false
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["/^Microsoft\\.CodeAnalysis(\\.|$)/"],
      "groupName": "Roslyn"
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["/^TUnit(\\.|$)/", "/^Microsoft\\.Testing\\./"],
      "groupName": "test runner"
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["/^StyleSharp\\./", "/^PerformanceSharp\\./", "/^SecuritySharp\\./"],
      "groupName": "analyzers",
      "labels": ["dependencies", "build-gate"]
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["BenchmarkDotNet"],
      "ignoreUnstable": false
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["MinVer"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["pin", "pinDigest"],
      "group": { "commitMessageTopic": "GitHub Actions digests" }
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["/^actions\\//", "/^github\\//", "/^microsoft\\//"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^mcr\\.microsoft\\.com\\//", "/^ghcr\\.io\\/reactiveui\\//", "docker/dockerfile"],
      "matchUpdateTypes": ["digest", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "matchManagers": ["pip_requirements"],
      "groupName": "documentation tools"
    },
    {
      "description": "Keep .NET 10 package entries on 10.x.",
      "matchDatasources": ["nuget"],
      "matchPackageNames": [
        "/^Microsoft\\.Extensions\\./",
        "/^Microsoft\\.AspNetCore\\./",
        "/^Microsoft\\.NETCore\\./",
        "/^Microsoft\\.SourceLink\\./",
        "Microsoft.Build.Tasks.Git",
        "/^System\\./"
      ],
      "matchCurrentValue": "/^10\\./",
      "allowedVersions": "/^10\\./",
      "ignoreUnstable": true,
      "groupName": ".NET 10 packages",
      "groupSlug": "dotnet-10"
    },
    {
      "description": "Keep .NET 11 package entries on 11.x.",
      "matchDatasources": ["nuget"],
      "matchPackageNames": [
        "/^Microsoft\\.Extensions\\./",
        "/^Microsoft\\.AspNetCore\\./",
        "/^Microsoft\\.NETCore\\./",
        "/^Microsoft\\.SourceLink\\./",
        "Microsoft.Build.Tasks.Git",
        "/^System\\./"
      ],
      "matchCurrentValue": "/^11\\./",
      "allowedVersions": "/^11\\./",
      "ignoreUnstable": false,
      "groupName": ".NET 11 packages",
      "groupSlug": "dotnet-11"
    }
  ]
}
