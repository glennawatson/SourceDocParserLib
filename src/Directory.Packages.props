<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <PropertyGroup>
    <RoslynCommonAnalyzersVersion>5.1.4</RoslynCommonAnalyzersVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageVersion Include="ICSharpCode.Decompiler" Version="11.2.0.10050" />
    <PackageVersion Include="Microsoft.CodeAnalysis" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.12.0" />
  </ItemGroup>

  <Choose>
    <When Condition="'$(TargetFramework)' == 'net11.0'">
      <ItemGroup>
        <PackageVersion Include="System.Threading.RateLimiting" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
        <PackageVersion Include="System.Security.Cryptography.Xml" Version="11.0.0" />
        <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageVersion Include="System.Threading.RateLimiting" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
        <PackageVersion Include="System.Security.Cryptography.Xml" Version="11.0.0" />
        <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
      </ItemGroup>
    </Otherwise>
  </Choose>

  <ItemGroup>
    <PackageVersion Include="NuGet.Commands" Version="8.0.0" />
    <PackageVersion Include="NuGet.Frameworks" Version="8.0.0" />
    <PackageVersion Include="NuGet.Versioning" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Docfx.Dotnet is referenced only by the head-to-head comparison
         benchmark project; never by the production library. Lives in
         its own benchmark assembly so docfx's transitive Roslyn /
         Decompiler pins stay isolated and can be VersionOverride'd
         locally if a future docfx release drops back to older deps. -->
    <PackageVersion Include="Docfx.Dotnet" Version="2.81.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="StyleSharp.Analyzers" Version="$(RoslynCommonAnalyzersVersion)" />
    <PackageVersion Include="PerformanceSharp.Analyzers" Version="$(RoslynCommonAnalyzersVersion)" />
    <PackageVersion Include="SecuritySharp.Analyzers" Version="$(RoslynCommonAnalyzersVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="TUnit" Version="1.84.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
  </ItemGroup>
</Project>
