<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <RootNamespace>Docfx.StandaloneBenchmarks</RootNamespace>
    <!-- BenchmarkDotNet uses reflection extensively. -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <NoWarn>$(NoWarn);CA1822;S1215;S4261</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" VersionOverride="0.15.8" />
    <PackageReference Include="Docfx.Dotnet" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.0.0" />
    <PackageReference Include="ICSharpCode.Decompiler" VersionOverride="9.1.0.7988" />
    <PackageReference Include="YamlDotNet" VersionOverride="16.3.0" />
  </ItemGroup>

</Project>
