<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <PackageId>SourceDocParser.Zensical</PackageId>
    <Description>Zensical / mkdocs Material emitter for SourceDocParser. Renders the parser's ApiCatalog into a flat tree of Markdown pages tuned for the Zensical theme (admonitions, content tabs, mermaid diagrams).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SourceDocParser\SourceDocParser.csproj" />
    <ProjectReference Include="..\SourceDocParser.Common\SourceDocParser.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SourceDocParser.Zensical.Tests" />
    <InternalsVisibleTo Include="SourceDocParser.Benchmarks" />
  </ItemGroup>

</Project>
